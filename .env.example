# Never commit the real key.
OPENALEX_API_KEY=replace_me
CLARIVATE_API_KEY=replace_me
GEMINI_API_KEY=replace_me   # ai_triage.py only

# Admin login/session settings
SECRET_KEY=replace_with_a_long_random_value
ADMIN_PASSWORD=replace_with_admin_password

# Admin "Refresh data" button. Off unless set to 1, so the deployed server
# (which refreshes offline) never exposes it by accident. On for local dev.
REFRESH_ENABLED=1
